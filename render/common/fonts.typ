// ============================================================================
// FONTS
// The one place that names the fonts, and the body text size. Each renderer sets its
// own sizes for the cipher body.
// ============================================================================

#let body-font = "Noto Serif"
#let title-font = "Noto Sans"
#let mono-font = "Noto Sans Mono"
// The answer key's answers: Typst's default serif, built into Typst (owner, 2026-11-16)
#let answer-font = "Libertinus Serif"

#let body-size = 10pt

// The ciphertext's weight: SemiBold, a tad below bold, for legibility and to save ink. Labels
// and cribs stay bold.
#let cipher-weight = 600
